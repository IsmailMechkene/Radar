{
  "name": "radar",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop app that searches job boards, career pages and student programs for internships and jobs abroad.",
  "author": "Ismail Mechkene",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "shot": "electron-vite build && electron . --radar-shot",
    "icons": "electron scripts/make-icons.mjs",
    "scan:dry": "tsx src/cli.ts scan --dry",
    "scan": "tsx src/cli.ts scan",
    "rescore": "tsx src/cli.ts rescore",
    "remind:dry": "tsx src/cli.ts remind --dry",
    "supabase:keepalive": "node --env-file=.env scripts/supabase-keepalive.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "lucide-react": "1.50.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
